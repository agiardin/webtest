{
  "version": 2,
  "builds": [
    {
      "src": "index.js",
      "use": "@vercel/node"
    },
    {
      "src": "plants/**",
      "use": "@vercel/static"
    },
    {
      "src": "sandcastle/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/plants/(.*)",
      "dest": "/plants/$1"
    },
    {
      "src": "/sandcastle/(.*)",
      "dest": "/sandcastle/$1"
    },
    {
      "src": "/(.*)",
      "dest": "index.js"
    }
  ]
}
